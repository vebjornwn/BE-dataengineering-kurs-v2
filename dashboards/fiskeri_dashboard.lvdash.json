{
  "datasets": [
    {
      "name": "historikk",
      "displayName": "Historisk fangst",
      "queryLines": [
        "SELECT\n",
        "  uke_start,\n",
        "  art_kode,\n",
        "  art_navn,\n",
        "  fangstomrade_kode,\n",
        "  fangstomrade_navn,\n",
        "  landet_kg,\n",
        "  antall_landinger,\n",
        "  aktive_fartoy,\n",
        "  havtemperatur_c,\n",
        "  bolgehoyde_m,\n",
        "  stromhastighet_ms\n",
        "FROM mart_fangst_uke"
      ]
    },
    {
      "name": "prognose",
      "displayName": "Prognose",
      "queryLines": [
        "SELECT\n",
        "  target_uke_start AS uke_start,\n",
        "  art_navn,\n",
        "  fangstomrade_navn,\n",
        "  'Faktisk' AS serie,\n",
        "  landet_kg_neste_uke AS kg\n",
        "FROM prediksjoner\n",
        "\n",
        "UNION ALL\n",
        "\n",
        "SELECT\n",
        "  target_uke_start AS uke_start,\n",
        "  art_navn,\n",
        "  fangstomrade_navn,\n",
        "  'Predikert' AS serie,\n",
        "  predikert_kg_neste_uke AS kg\n",
        "FROM prediksjoner"
      ]
    }
  ],
  "pages": [
    {
      "name": "oversikt",
      "displayName": "Oversikt",
      "layout": [
        {
          "widget": {
            "name": "tittel",
            "multilineTextboxSpec": {
              "lines": [
                "# Fiskeri – fangst og prognose\n",
                "Fra Bronze til Gold, maskinlæring og beslutningsstøtte"
              ]
            }
          },
          "position": {
            "x": 0,
            "y": 0,
            "width": 12,
            "height": 1
          }
        },
        {
          "widget": {
            "name": "filter_art",
