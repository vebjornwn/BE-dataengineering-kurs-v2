                    {
                      "name": "art_navn",
                      "expression": "`art_navn`"
                    },
                    {
                      "name": "art_navn_associativity",
                      "expression": "COUNT_IF(`associative_filter_predicate_group`)"
                    }
                  ],
                  "disaggregated": false
                }
              },
              {
                "name": "filter_art_prognose",
                "query": {
                  "datasetName": "prognose",
